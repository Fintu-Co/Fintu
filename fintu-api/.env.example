# ── Servidor ──
PORT=5000
FRONTEND_URL=http://localhost:5173        # en producción: https://tu-dominio.com

# ── MySQL ──
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=fintu_db
DB_PORT=3306

# ── JWT ──
JWT_SECRET=                               # genera uno largo y aleatorio para producción

# ── Email (recuperación de contraseña) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── PayPal (developer.paypal.com → Apps & Credentials) ──
# El SECRET jamás va al frontend ni a git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # producción: https://api-m.paypal.com
# Planes: los primeros FUNDADORES_LIMITE pagan PRECIO_FUNDADOR_USD una vez (de por vida);
# despues, PRECIO_ANUAL_USD por cada ano. El backend decide la oferta y verifica el monto.
FUNDADORES_LIMITE=100
PRECIO_FUNDADOR_USD=5.00
PRECIO_ANUAL_USD=10.00
